# SARI Eyes node configuration template. Copy to .env (never committed) and fill in real values.
# Every <placeholder> is required: the node refuses to start when one is missing.

# Node identity (must match the MQTT username and the brain's SARI_NODE_KEYS entry)
JETSON_NODE_ID=Jetson-PTZ_1
JETSON_NODE_IP=<jetson-lan-ip>

# Hikvision PTZ camera (use a dedicated low-privilege operator account, not admin)
CAMERA_IP=<camera-ip>
CAMERA_USER=<camera-user>
CAMERA_PASS=<camera-password>

# Brain MQTT broker
MQTT_BROKER_HOST=<brain-host>
MQTT_BROKER_PORT=1883
MQTT_USER=Jetson-PTZ_1
MQTT_PASSWORD=<mqtt-password>

# Direct Telegram fallback
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>

# Detection / stream
CONFIDENCE_THRESHOLD=0.70
STREAM_PORT=8080
