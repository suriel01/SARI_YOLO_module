# /etc/sari/jetson.env for deploy/sari-jetson.service (install as root:root, mode 0600).
# Placeholders in <...> are required; the agent refuses to start without them.
JETSON_NODE_ID=Jetson-PTZ_1
JETSON_NODE_NAME=Jetson Orin Nano (PTZ 1)
JETSON_NODE_IP=<jetson-lan-ip>

MQTT_BROKER_HOST=<brain-host>
MQTT_BROKER_PORT=1883
# Must equal JETSON_NODE_ID (broker ACL sari/nodes/%u/...)
MQTT_USER=Jetson-PTZ_1
MQTT_PASSWORD=<mqtt-password>
# Optional TLS (default port becomes 8883)
# MQTT_TLS_CA=/etc/sari/mqtt-ca.crt

# HTTP fallback when MQTT is down (brain API, port 7000)
CEREBRO_HTTP_TELEMETRY_URL=http://<brain-host>:7000/api/telemetry/node
SARI_NODE_KEY=<node-key>
